{
  "$id": "https://waysnx.com/schemas/ui-security/featuregate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content to render if feature is enabled",
  "metadata": {
    "accessibility": {
      "ariaRoles": [],
      "keyboardSupport": [],
      "wcagLevel": "AA"
    },
    "category": "components",
    "hasExamples": false,
    "hasStories": false,
    "hasTests": false,
    "isForwardRef": false,
    "isMemo": false,
    "library": "ui-security",
    "version": "1.0.0"
  },
  "properties": {
    "children": {
      "description": "Content to render if feature is enabled",
      "type": "string"
    },
    "className": {
      "description": "Additional CSS class",
      "type": "string"
    },
    "fallback": {
      "description": "Content to render if feature is disabled",
      "type": "string"
    },
    "featureId": {
      "description": "Feature flag identifier",
      "type": "string"
    },
    "isEnabled": {
      "description": "Whether feature is enabled",
      "type": "boolean"
    },
    "unmountOnDisable": {
      "description": "Whether to completely remove from DOM (vs just hiding)",
      "type": "boolean"
    }
  },
  "required": [
    "featureId",
    "isEnabled",
    "children"
  ],
  "title": "FeatureGate",
  "type": "object"
}