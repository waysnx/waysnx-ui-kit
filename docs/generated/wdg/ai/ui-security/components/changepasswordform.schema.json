{
  "$id": "https://waysnx.com/schemas/ui-security/changepasswordform.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Password policy for validation",
  "metadata": {
    "accessibility": {
      "ariaRoles": [],
      "keyboardSupport": [],
      "wcagLevel": "AA"
    },
    "category": "components",
    "hasExamples": false,
    "hasStories": false,
    "hasTests": false,
    "isForwardRef": false,
    "isMemo": false,
    "library": "ui-security",
    "version": "1.0.0"
  },
  "properties": {
    "className": {
      "description": "Custom CSS class",
      "type": "string"
    },
    "error": {
      "description": "Error message to display",
      "type": "string"
    },
    "loading": {
      "description": "Loading state (shows spinner on button)",
      "type": "boolean"
    },
    "onSubmit": {
      "description": "Callback when form is submitted",
      "enum": [
        "(data: ChangePassword) => void",
        "Promise<void>"
      ]
    },
    "policy": {
      "description": "Password policy for validation",
      "type": "string"
    },
    "showStrength": {
      "description": "Show password strength feedback",
      "type": "boolean"
    },
    "success": {
      "description": "Success message (typically cleared after timeout)",
      "type": "string"
    }
  },
  "required": [
    "policy",
    "onSubmit"
  ],
  "title": "ChangePasswordForm",
  "type": "object"
}