{
  "$id": "https://waysnx.com/schemas/ui-security/forgotpasswordform.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Password policy for validation",
  "metadata": {
    "accessibility": {
      "ariaRoles": [],
      "keyboardSupport": [],
      "wcagLevel": "AA"
    },
    "category": "components",
    "hasExamples": false,
    "hasStories": false,
    "hasTests": false,
    "isForwardRef": false,
    "isMemo": false,
    "library": "ui-security",
    "version": "1.0.0"
  },
  "properties": {
    "className": {
      "description": "Custom CSS class",
      "type": "string"
    },
    "error": {
      "description": "Error message",
      "type": "string"
    },
    "loading": {
      "description": "Loading state",
      "type": "boolean"
    },
    "onBackToLogin": {
      "description": "Callback to return to login",
      "type": "null"
    },
    "onSubmitEmail": {
      "description": "Callback when email is submitted",
      "enum": [
        "(email: string) => void",
        "Promise<void>"
      ]
    },
    "onSubmitReset": {
      "description": "Callback when reset form is submitted",
      "enum": [
        "(data: PasswordResetFormData) => void",
        "Promise<void>"
      ]
    },
    "policy": {
      "description": "Password policy for validation",
      "type": "string"
    },
    "showStrength": {
      "description": "Show password strength feedback",
      "type": "boolean"
    },
    "success": {
      "description": "Success message",
      "type": "string"
    }
  },
  "required": [
    "policy"
  ],
  "title": "ForgotPasswordForm",
  "type": "object"
}