{
  "$id": "https://waysnx.com/schemas/ui-security/rolegate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content to render if role matches",
  "metadata": {
    "accessibility": {
      "ariaRoles": [],
      "keyboardSupport": [],
      "wcagLevel": "AA"
    },
    "category": "components",
    "hasExamples": false,
    "hasStories": false,
    "hasTests": false,
    "isForwardRef": false,
    "isMemo": false,
    "library": "ui-security",
    "version": "1.0.0"
  },
  "properties": {
    "children": {
      "description": "Content to render if role matches",
      "type": "string"
    },
    "className": {
      "description": "Additional CSS class",
      "type": "string"
    },
    "fallback": {
      "description": "Content to render if role doesn't match",
      "type": "string"
    },
    "requireAll": {
      "description": "Require all roles (and) or any role (or)",
      "type": "boolean"
    },
    "role": {
      "description": "Role(s) required to view children",
      "enum": [
        "string",
        "string[]"
      ]
    },
    "unmountOnDeny": {
      "description": "Whether to completely remove from DOM (vs just hiding)",
      "type": "boolean"
    },
    "userRoles": {
      "description": "User's current roles",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "role",
    "userRoles",
    "children"
  ],
  "title": "RoleGate",
  "type": "object"
}