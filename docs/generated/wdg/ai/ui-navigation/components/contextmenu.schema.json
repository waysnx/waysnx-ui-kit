{
  "$id": "https://waysnx.com/schemas/ui-navigation/contextmenu.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Display context-sensitive actions triggered by right-click or long-press.",
  "metadata": {
    "accessibility": {
      "ariaRoles": [],
      "keyboardSupport": [],
      "wcagLevel": "AA"
    },
    "category": "components",
    "hasExamples": false,
    "hasStories": false,
    "hasTests": false,
    "isForwardRef": true,
    "isMemo": false,
    "library": "ui-navigation",
    "version": "1.0.0"
  },
  "properties": {
    "ariaLabel": {
      "description": "Accessible label for menu",
      "type": "string"
    },
    "className": {
      "description": "Additional CSS class",
      "type": "string"
    },
    "density": {
      "description": "Component density",
      "enum": [
        "compact",
        "normal",
        "spacious"
      ]
    },
    "isOpen": {
      "description": "Whether menu is visible",
      "type": "boolean"
    },
    "items": {
      "description": "Menu items to display",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "keyboardNav": {
      "description": "Keyboard navigation enabled",
      "type": "boolean"
    },
    "maxDepth": {
      "description": "Maximum depth for nested items",
      "type": "number"
    },
    "offset": {
      "description": "Offset from mouse position",
      "type": "number"
    },
    "onClose": {
      "description": "Callback when context menu is closed",
      "type": "null"
    },
    "onItemClick": {
      "description": "Callback when item is clicked",
      "type": "null"
    },
    "onOpen": {
      "description": "Callback when context menu is opened",
      "type": "null"
    },
    "position": {
      "description": "Menu position",
      "type": "string"
    },
    "security": {
      "description": "Security context for permission-based filtering",
      "type": "string"
    },
    "showBadges": {
      "description": "Whether to show badges",
      "type": "boolean"
    },
    "showIcons": {
      "description": "Whether to show icons",
      "type": "boolean"
    },
    "style": {
      "description": "Additional styles",
      "type": "string"
    },
    "variant": {
      "description": "Theme variant",
      "enum": [
        "default",
        "minimal",
        "elevated"
      ]
    }
  },
  "required": [
    "items"
  ],
  "title": "ContextMenu",
  "type": "object"
}