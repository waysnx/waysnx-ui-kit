{
  "$id": "https://waysnx.com/schemas/ui-navigation/navbar.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Display a horizontal navigation bar with multiple navigation links.",
  "metadata": {
    "accessibility": {
      "ariaRoles": [],
