{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "declaration": true,
    "emitDeclarationOnly": false,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node", "react", "react-dom"]
  },
  "include": ["src"]
}
